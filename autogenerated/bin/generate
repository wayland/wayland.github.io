#!/usr/bin/env raku

# Build this-site/generated/{files,site-contents,rss}.xml for one or more sites.
# Default: blog (in-repo). Pass checkout paths for siblings, e.g.
#   autogenerated/bin/generate blog
#   autogenerated/bin/generate ../../table-oriented-programming/current-web
#
# Title, description, sitedir, structure, etc. are read by the XSL from
# this-site/site-config.xml (not parsed here). The path basename (or parent
# of current-web/main) must match site-config <sitedir> for file @src prefixes.
# Optional page <nav-order> is copied onto files.xml @nav-order for XSL sorting.

use	DateTime::Format::RFC2822;

my $repo-root = $*PROGRAM.resolve.parent.parent.parent;

sub	MAIN(*@paths, Bool :$verbose) {
	@paths = <blog> unless @paths.elems;

	for @paths -> $path-arg {
		my $path = resolve-site-path($path-arg);
		my $slug = deploy-slug($path);
		my $gen-dir = $path.add('this-site').add('generated');
		$gen-dir.mkdir unless $gen-dir.d;

		my $config = $path.add('this-site').add('site-config.xml');
		die "missing site config: $config" unless $config.f;

		##### Create files.xml
		my @entries = xml-find($path, $slug);
		my $filelist-filename = $gen-dir.add('files.xml');
		my $contents = qq:to /EOT/;
		<?xml version="1.0" encoding="UTF-8"?>
		<filesystem-info xml:base="../..">
			<lastBuildDate>{DateTime::Format::RFC2822.to-string(DateTime.now)}</lastBuildDate>
			<file-list>
		EOT

		for @entries -> $entry {
			my $abs = $entry<abs>.IO;
			my @extra-attrs;
			@extra-attrs.push: 'is-index="1"' if $entry<src> ~~ /index.xml$/;
			with page-nav-order($abs) -> $nav {
				@extra-attrs.push: "nav-order=\"{$nav}\"";
			}
			my $extra = @extra-attrs ?? ' ' ~ @extra-attrs.join(' ') !! '';
			# Closing EOT indent matches `$contents` so <file> keeps two tabs under <file-list>.
			$contents ~= qq:c:to /EOT/;
				<file src=\"{$entry<src>}\" created="{$abs.created.Date}" modified="{$abs.modified.Date}"{$extra}/>
		EOT
		}

		$contents ~= q:to /EOT/;
			</file-list>
		</filesystem-info>
		EOT

		$filelist-filename.spurt: $contents;
		shell('xml_pp ' ~ shell-quote($filelist-filename.absolute)) if $verbose;

		# document() in XSL needs $repo-root/$slug → site for sibling checkouts
		my $link = ensure-doc-link($path, $slug);
		my %params =
			'site-config' => "$slug/this-site/site-config.xml",
			'files-xml' => "$slug/this-site/generated/files.xml",
		;
		die "site-config not reachable at $repo-root/%params{'site-config'}"
			unless $repo-root.add(%params{'site-config'}).e;

		xsltproc
			$repo-root.add('autogenerated/xsl/site-contents.xsl'),
			$filelist-filename,
			$gen-dir.add('site-contents.xml'),
			:stringparams(%params),
			:$verbose;

		xsltproc
			$repo-root.add('autogenerated/xsl/rss.xsl'),
			$filelist-filename,
			$gen-dir.add('rss.xml'),
			:stringparams(%params),
			:$verbose;

		remove-doc-link($link) if $link;
		note "Generated $slug → {$gen-dir.absolute}";
	}
}

sub	xsltproc(
	IO() $stylesheet,
	IO() $source,
	IO() $destination,
	:%stringparams,
	Bool :$verbose,
) {
	my $cmd = 'xsltproc';
	for %stringparams.kv -> $name, $value {
		$cmd ~= ' --stringparam ' ~ shell-quote(~$name) ~ ' ' ~ shell-quote(~$value);
	}
	$cmd ~= ' ' ~ shell-quote($stylesheet.absolute);
	$cmd ~= ' ' ~ shell-quote($source.absolute);
	$cmd ~= ' > ' ~ shell-quote($destination.absolute);
	shell($cmd);
	shell('xml_pp ' ~ shell-quote($destination.absolute)) if $verbose;
}

sub	resolve-site-path(Str $path-arg --> IO::Path) {
	my $p = $path-arg.IO;
	return $p.resolve if $p.is-absolute;
	return $repo-root.add($path-arg).resolve;
}

sub	deploy-slug(IO::Path $path --> Str) {
	my $slug = $path.basename;
	$slug = $path.parent.basename if $slug eq 'current-web' | 'main';
	return $slug;
}

# Optional <nav-order>…</nav-order> from page metadata (numeric / dotted, e.g. 2.3).
sub	page-nav-order(IO::Path $file) {
	my $text = try $file.slurp;
	return Nil without $text;
	if $text ~~ / '<nav-order>' $<v>=(<-[<]>+) '</nav-order>' / {
		my $v = (~$<v>).trim;
		return $v if $v.chars;
	}
	return Nil;
}

sub	xml-find(IO::Path $path, Str $slug) {
	my $find-command = 'find ' ~ shell-quote($path.absolute) ~ " -name '*.xml'";
	my @abs = qqx{$find-command}.lines;
	my @out;
	for @abs -> $abs {
		next if $abs ~~ /this\-site|templates|\/interface\//;
		next if $abs.ends-with('.svg.xml');
		my $rel = $abs.IO.relative($path);
		@out.push: %( src => "$slug/$rel", abs => $abs );
	}
	return @out;
}

sub	ensure-doc-link(IO::Path $path, Str $slug) {
	my $target = $repo-root.add($slug).resolve;
	return Nil if $path.absolute eq $target.absolute;
	my $link = $repo-root.add($slug);
	if $link.l {
		return Nil if $link.resolve.absolute eq $path.absolute;
		die "cannot link $slug for document(): {$link.absolute} points elsewhere";
	}
	if $link.e {
		die "cannot link $slug for document(): {$link.absolute} already exists";
	}
	$path.symlink($link);
	return $link;
}

sub	remove-doc-link($link) {
	unlink $link if $link && $link.l;
}

sub	shell-quote(Str $s --> Str) {
	return "'" ~ (S:g/\'/\'\\\'\'/ with $s) ~ "'";
}
